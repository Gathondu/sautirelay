# Frontend
PUBLIC_API_URL=http://localhost:8000

# Backend
ENV=dev
LOG_LEVEL=info
DEMO_SEED_ENABLED=true
DEMO_SEED_WITH_AI=true
AI_ALLOW_DETERMINISTIC_FALLBACK=false
LOCAL_DATA_DIR=.local-data
REPOSITORY_BACKEND=local
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.5
OPENAI_MAX_OUTPUT_TOKENS=1200
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=
EMBEDDING_INPUT_TYPE=
EMBEDDING_EXTRA_BODY={}
EMBEDDING_EXTRA_HEADERS={}
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type

# AWS deployment
PROJECT_NAME=sautirelay
ENVIRONMENT=prod
AWS_REGION=af-south-1
FRONTEND_BUCKET=
FRONTEND_BUCKET_NAME=
LAMBDA_FUNCTION_NAME=
DYNAMODB_TABLE_NAME=
S3_VECTOR_BUCKET_NAME=
S3_VECTOR_INDEX_NAME=report-embeddings
VERIFIER_USERNAME=verifier@sautirelay.dev
MEDIATOR_USERNAME=mediator@sautirelay.dev
