# Frontend
PUBLIC_SAUTIRELAY_API_URL=http://localhost:8000

# Backend
SAUTIRELAY_ENV=dev
SAUTIRELAY_LOG_LEVEL=info
SAUTIRELAY_CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SAUTIRELAY_CORS_ALLOW_CREDENTIALS=false
SAUTIRELAY_CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
SAUTIRELAY_CORS_ALLOW_HEADERS=Authorization,Content-Type

# Future deployment placeholders only. Do not add deployment code yet.
AWS_REGION=
FRONTEND_BUCKET=
LAMBDA_FUNCTION_NAME=
