# Optional non-secret deployment overrides for local deploy experiments.
# In GitHub, prefer repository Variables with these same names.

PROJECT_NAME=sautirelay
ENVIRONMENT=prod
AWS_REGION=af-south-1

# Leave these blank to use Terraform's account-scoped defaults.
FRONTEND_BUCKET_NAME=
LAMBDA_FUNCTION_NAME=
DYNAMODB_TABLE_NAME=
S3_VECTOR_BUCKET_NAME=
S3_VECTOR_INDEX_NAME=report-embeddings

OPENAI_MODEL=gpt-5.5
OPENAI_BASE_URL=
OPENAI_MAX_OUTPUT_TOKENS=1200
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_INPUT_TYPE=
EMBEDDING_EXTRA_BODY={}
EMBEDDING_EXTRA_HEADERS={}
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type
DEMO_SEED_ENABLED=false
DEMO_SEED_WITH_AI=false
AI_ALLOW_DETERMINISTIC_FALLBACK=false
VERIFIER_USERNAME=verifier@sautirelay.dev
MEDIATOR_USERNAME=mediator@sautirelay.dev
